PORT=5001
MONGODB_URI=your_mongodb_atlas_uri
CLICKUP_API_KEY=your_clickup_api_key
CLICKUP_LIST_ID=your_clickup_list_id
CLICKUP_FORM_LINK_FIELD_ID=your_clickup_form_link_field_id
FRONTEND_URL=https://your-frontend-url.onrender.com

# Zugangsschutz (Pflicht — ohne diese Werte liefert die API keine Daten)
# Zufallswert, mindestens 32 Zeichen: openssl rand -base64 48
AUTH_SECRET=
# Passwort, mit dem sich Mitarbeiter im Formular anmelden
STAFF_PASSWORD=
# Gültigkeit eines Logins in Stunden (Standard 12)
AUTH_TOKEN_TTL_HOURS=12
# Schlüssel für Automationen (ClickUp/Make), Header "X-API-Key": openssl rand -hex 32
INTEGRATION_API_KEY=
