APP_ENV=development
PORT=5001
FRONTEND_URL=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/formular-dev
MONGODB_DB_NAME=formular-dev
# Use secret files on the server, e.g. AUTH_SECRET_FILE=/run/secrets/auth_secret.
AUTH_SECRET=
STAFF_PASSWORD=
INTEGRATION_API_KEY=
AUTH_TOKEN_TTL_HOURS=12
CORS_ORIGINS=
# Direct local access trusts no proxy. Compose supplies uniquelocal for Caddy.
TRUST_PROXY=
MAINTENANCE_MODE=false
# Off by default. Non-production allows only local stub URLs.
MAKE_WEBHOOKS_ENABLED=false
MAKE_UPDATE_WEBHOOK_URL=
MAKE_PKONTO_WEBHOOK_URL=
RELEASE_SHA=local
