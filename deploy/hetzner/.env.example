# These are non-secret deployment settings. No production credentials here.
APP_ENV=staging
FORMULAR_DOMAIN=http://localhost
FRONTEND_URL=http://localhost:8086
HTTP_BIND=127.0.0.1
HTTP_PORT=8086
HTTPS_BIND=127.0.0.1
HTTPS_PORT=8446
MONGODB_DB_NAME=formular
# EXAMPLE ONLY: verify source version/FCV before moving any real data.
MONGO_IMAGE=mongo:8.0
MONGO_DATA_PATH=/srv/formular/mongo
RELEASE_SHA=local
MAKE_WEBHOOKS_ENABLED=false
MAINTENANCE_MODE=true
CORS_ORIGINS=
